# cp .env.example .env
# Hostnames (postgres, valkey, mailpit, keycloak, fsp-mock, api) are docker compose services.
# Running the API outside Docker: point DATABASE_URL, VALKEY_URL, SMTP_URL at localhost.
# Compose passes this file to api, postgres, keycloak, fsp-mock and ats-mock (env_file). It does not
# use it for ${...} interpolation in deploy/compose.yml: KC_HOSTNAME, GRAFANA_ADMIN_USER/PASSWORD and
# the web service's API_PROXY_URL come from the shell or deploy/.env. `make api` does not read it.
#
# All keys and secrets below are public dev values for local demos only.
# For any shared deployment generate new ones: openssl rand -base64 32

# --- API ---
# Listen address (compose sets it for the api service itself)
API_BIND=0.0.0.0:8000
# Browser-facing origin: links in emails, the CSRF Origin check, redirects after FSP ID linking
PUBLIC_URL=http://localhost:8080
# Public site address for canonical links, sitemap, OG images and llms.txt. Compose reads it from the shell or
# deploy/.env (not this file) and bakes it into the web image at build time: rebuild web after changing it.
SITE_URL=http://localhost:8080
# true behind HTTPS
COOKIE_SECURE=false
# tracing filter (EnvFilter syntax)
RUST_LOG=info,api=debug
# json | pretty
LOG_FORMAT=json
# Fill demo companies, candidates and logins at startup; runs only on an empty database
SEED_DEMO=true
# Candidates per specialization in the demo seed (load tests: 1667 gives 10 002)
# SEED_CANDIDATES_PER_SPEC=40
# Minimum interval between grade changes after a category is assigned (T-6)
GRADE_CHANGE_COOLDOWN_DAYS=90
# Video of the test: optional (the candidate chooses) | off (no proctoring step)
PROCTORING=optional
# Encrypted video chunks (compose mounts a named volume here); kept for PROCTORING_RETENTION_DAYS
PROCTORING_DIR=/var/lib/fsp/proctoring
PROCTORING_RETENTION_DAYS=90

# --- Sentence embeddings (embedder service, multilingual-e5-small) ---
# off: text closeness by keywords, similar vacancies by skills, no paraphrase check — as without ML.
# Compose points the api at the embedder (EMBEDDER_URL=http://embedder:8093); `make api` at localhost.
EMBEDDINGS=on
# Per request from the api to the embedder
# EMBEDDER_TIMEOUT_MS=15000
# How often the idle embedding worker looks at the queue
# EMBEDDINGS_INTERVAL_MS=1000

# --- PostgreSQL (DATABASE_URL must match POSTGRES_*) ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp_hack
DATABASE_URL=postgres://fsp:fsp@postgres:5432/fsp_hack
# Connections per API replica. 16 balances throughput and p95 on ~10 cores; fewer lowers tail latency.
DATABASE_POOL_SIZE=16

# --- Valkey: rate limits, revoked access tokens, candidate cache generation ---
# Unset: the same data lives in API process memory (single replica only)
VALKEY_URL=redis://valkey:6379

# --- Keys: 32 random bytes each, base64 ---
# JWT_ED25519_SEED_B64 signs access tokens (EdDSA); unset: a random key per start, sessions die on restart.
# FIELD_ENC_KEY encrypts personal data, webhook secrets and proctoring video (XChaCha20-Poly1305);
# BIDX_KEY keys the email blind index (HMAC-SHA256). Set both or neither; changing them makes
# existing data unreadable.
JWT_ED25519_SEED_B64=wp6i9DnLohHEs4Jb66CzIWN/w9J5fVap5lifPXpkPOI=
FIELD_ENC_KEY=TXnLtWohPgSRBmpWI2bPsOgIEOwRBI4eTzFWxffNbB8=
BIDX_KEY=bgKmMBmDFUKZaaWYDe5iswASSiPfSr0lvBEZQrDmQOo=

# --- Mail: smtp sends via SMTP_URL, log prints links to the API log ---
MAIL_MODE=smtp
# smtp://host:port — plain SMTP (Mailpit). A real mail service: smtps://user:password@host:465
# or smtp://user:password@host:587?tls=required; an @ in the login is written as %40.
SMTP_URL=smtp://mailpit:1025
# Sender address of all platform mail
MAIL_FROM=no-reply@fsp-talent.local
# Notification letters (docs/architecture.md section 13): an item waits this long for others to join its
# letter, a recipient gets at most one letter per gap and DAILY_CAP a day; a new invitation skips
# the gap, not the hold or the cap
NOTIFY_EMAIL_HOLD_SECS=120
NOTIFY_EMAIL_GAP_SECS=600
NOTIFY_EMAIL_DAILY_CAP=10
NOTIFY_INTERVAL_MS=5000

# --- ФСП ID (Keycloak realm fsp, compose profile fsp) ---
# Browser-facing issuer; it is also the `iss` of every token.
FSP_OIDC_ISSUER=http://localhost:8081/realms/fsp
# Server-to-server discovery inside the compose network; Keycloak rewrites token/userinfo/jwks
# URLs to this host, while `issuer` stays FSP_OIDC_ISSUER.
FSP_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/fsp/.well-known/openid-configuration
FSP_OIDC_CLIENT_ID=fsp-talent
# Keycloak reads the same value when importing deploy/keycloak/fsp-realm.json.
FSP_OIDC_CLIENT_SECRET=PT3AnBlIcCpPldjggqAitP8LPspqMfd8
FSP_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/fsp/link/callback

# --- Реестр ФСП (fsp-mock) ---
# Registry of achievements; unset: linking works, achievements are not synced
FSP_REGISTRY_URL=http://fsp-mock:8090
# Bearer token the API sends to the registry; fsp-mock expects the same value (and on its admin
# endpoints, which change achievements for demos)
FSP_REGISTRY_TOKEN=dev-registry-token
# Shared secret of the registry's push POST /api/v1/fsp/registry/events (FSP-Signature, HMAC-SHA256).
# fsp-mock signs with the same value; unset: the API answers 503 and only pull works.
FSP_REGISTRY_WEBHOOK_SECRET=whsec_demo_fsp_registry_do_not_use_in_production
# true: link an entered fsp_id without Keycloak (local dev only)
FSP_DEV_LINK=false

# --- ATS integration (compose profile ats; README.md section 10) ---
# Hosts a webhook may reach over plain http and on private addresses. Production: empty —
# https to public addresses only.
WEBHOOK_DEV_HOSTS=ats-mock:8082
# Outbox polling period of the webhook dispatcher, ms
WEBHOOK_DISPATCH_INTERVAL_MS=2000
# GET /integrations/invitations returns only changes older than this, so a change still being
# committed is never jumped over by the cursor (docs/architecture.md section 11.2)
ATS_POLL_LAG_SECS=5
# Demo: at startup the api gives the demo company (employer@demo.fsp) this API key and a webhook
# to the ATS mock signed with this secret; the mock (ats-mock) reads the same two values.
# Without the ats profile running, deliveries to the mock fail and show up in the delivery log.
# The company is found by its owner's login, ATS_DEMO_OWNER_EMAIL (default employer@demo.fsp).
ATS_DEMO_API_KEY=fsp_live_demo_ats_key_do_not_use_in_production
ATS_DEMO_WEBHOOK_URL=http://ats-mock:8082/webhooks
ATS_DEMO_WEBHOOK_SECRET=whsec_demo_ats_secret_do_not_use_in_production

# --- Web (Next.js server-side calls) ---
# Where Next.js reaches the API: the /api/* rewrite (read by `next dev`, baked in by `next build`) and
# the server-side fetch of consent texts on /privacy. The compose web service does not read this file:
# it gets the value from the shell or deploy/.env, default http://api:8000. The api service ignores it.
API_PROXY_URL=http://api:8000

# --- Keycloak admin console (http://localhost:8081/admin) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
