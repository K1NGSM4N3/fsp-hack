# cp .env.example .env
# Hostnames (postgres, valkey, mailpit, keycloak, fsp-mock, api) are docker compose services.
# Running the API outside Docker: point DATABASE_URL, VALKEY_URL, SMTP_URL at localhost.
#
# All keys and secrets below are public dev values for local demos only.
# For any shared deployment generate new ones: openssl rand -base64 32

# --- API ---
API_BIND=0.0.0.0:8000
PUBLIC_URL=http://localhost:8080
# true behind HTTPS
COOKIE_SECURE=false
RUST_LOG=info,api=debug
# json | pretty
LOG_FORMAT=json
SEED_DEMO=true
GRADE_CHANGE_COOLDOWN_DAYS=90
# Video of the test: optional (the candidate chooses) | off (no proctoring step)
PROCTORING=optional
# Encrypted video chunks (compose mounts a named volume here); kept for PROCTORING_RETENTION_DAYS
PROCTORING_DIR=/var/lib/fsp/proctoring
PROCTORING_RETENTION_DAYS=90

# --- PostgreSQL (DATABASE_URL must match POSTGRES_*) ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp_hack
DATABASE_URL=postgres://fsp:fsp@postgres:5432/fsp_hack

# --- Valkey ---
VALKEY_URL=redis://valkey:6379

# --- Keys: 32 random bytes each, base64 ---
JWT_ED25519_SEED_B64=wp6i9DnLohHEs4Jb66CzIWN/w9J5fVap5lifPXpkPOI=
FIELD_ENC_KEY=TXnLtWohPgSRBmpWI2bPsOgIEOwRBI4eTzFWxffNbB8=
BIDX_KEY=bgKmMBmDFUKZaaWYDe5iswASSiPfSr0lvBEZQrDmQOo=

# --- Mail: smtp sends via SMTP_URL, log prints links to the API log ---
MAIL_MODE=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@fsp-talent.local

# --- ФСП ID (Keycloak realm fsp, compose profile fsp) ---
# Browser-facing issuer; it is also the `iss` of every token.
FSP_OIDC_ISSUER=http://localhost:8081/realms/fsp
# Server-to-server discovery inside the compose network; Keycloak rewrites token/userinfo/jwks
# URLs to this host, while `issuer` stays FSP_OIDC_ISSUER.
FSP_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/fsp/.well-known/openid-configuration
FSP_OIDC_CLIENT_ID=fsp-talent
# Keycloak reads the same value when importing deploy/keycloak/fsp-realm.json.
FSP_OIDC_CLIENT_SECRET=PT3AnBlIcCpPldjggqAitP8LPspqMfd8
FSP_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/fsp/link/callback

# --- Реестр ФСП (fsp-mock) ---
FSP_REGISTRY_URL=http://fsp-mock:8090
FSP_REGISTRY_TOKEN=dev-registry-token
# true: link an entered fsp_id without Keycloak (local dev only)
FSP_DEV_LINK=false

# --- Web (Next.js server-side calls) ---
API_PROXY_URL=http://api:8000

# --- Keycloak admin console (http://localhost:8081/admin) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
