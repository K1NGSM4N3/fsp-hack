# deploy/.env.template — production-shaped .env for the demo box.
# Rendered by deploy/render_env.py (stdlib only), never committed with real values:
#   python3 deploy/render_env.py --domain demo.arewehireyet.ru
# Markers: {{DOMAIN}}, {{POSTGRES_PASSWORD}} (one generated value, used twice),
# {{GEN_KEY32}} (fresh 32-byte base64 per occurrence), {{GEN_TOKEN}} (fresh alnum 32).

# --- API ---
API_BIND=0.0.0.0:8000
# Browser-facing origin: links in emails, the CSRF Origin check, redirects after FSP ID linking
PUBLIC_URL=https://{{DOMAIN}}
# Public site address; baked into the web image at build time (deploy/.env written by the renderer)
SITE_URL=https://{{DOMAIN}}
# true behind HTTPS
COOKIE_SECURE=true
RUST_LOG=info
LOG_FORMAT=json
# Fill demo companies, candidates and logins at startup; runs only on an empty database
SEED_DEMO=true
# SEED_CANDIDATES_PER_SPEC=40
GRADE_CHANGE_COOLDOWN_DAYS=90
# Video of the test: optional (the candidate chooses) | off (no proctoring step)
PROCTORING=optional
PROCTORING_DIR=/var/lib/fsp/proctoring
PROCTORING_RETENTION_DAYS=90

# --- Sentence embeddings (embedder service) ---
EMBEDDINGS=on

# --- PostgreSQL ---
POSTGRES_USER=fsp
POSTGRES_DB=fsp_hack
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
DATABASE_URL=postgres://fsp:{{POSTGRES_PASSWORD}}@postgres:5432/fsp_hack
DATABASE_POOL_SIZE=16

# --- Valkey ---
VALKEY_URL=redis://valkey:6379

# --- Keys: generated fresh by the renderer, store them in a password manager.
# JWT_ED25519_SEED_B64 signs access tokens; FIELD_ENC_KEY encrypts personal data and
# proctoring video; BIDX_KEY keys the email blind index. Changing = data unreadable.
JWT_ED25519_SEED_B64={{GEN_KEY32}}
FIELD_ENC_KEY={{GEN_KEY32}}
BIDX_KEY={{GEN_KEY32}}

# --- Mail: Mailpit (the /mail/ inbox) until a real mail service is set ---
# Real delivery: SMTP_URL=smtps://login%40example.ru:app-password@smtp.example.ru:465 and
# MAIL_FROM set to that mailbox (or a domain with SPF/DKIM in its DNS).
MAIL_MODE=smtp
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=no-reply@{{DOMAIN}}
NOTIFY_EMAIL_HOLD_SECS=120
NOTIFY_EMAIL_GAP_SECS=600
NOTIFY_EMAIL_DAILY_CAP=10
NOTIFY_INTERVAL_MS=5000

# --- ФСП ID (Keycloak realm fsp) ---
# Keycloak is served on the site's origin under /auth (compose.demo.yml, Caddyfile.demo).
# The issuer is the browser-facing URL; the API reads discovery inside the compose network.
FSP_OIDC_ISSUER=https://{{DOMAIN}}/auth/realms/fsp
FSP_OIDC_DISCOVERY_URL=http://keycloak:8080/auth/realms/fsp/.well-known/openid-configuration
FSP_OIDC_CLIENT_ID=fsp-talent
# Keycloak reads the same value when importing deploy/keycloak/fsp-realm.json.
FSP_OIDC_CLIENT_SECRET={{GEN_TOKEN}}
FSP_OIDC_REDIRECT_URL=https://{{DOMAIN}}/api/v1/fsp/link/callback

# --- Реестр ФСП (fsp-mock) ---
FSP_REGISTRY_URL=http://fsp-mock:8090
FSP_REGISTRY_TOKEN={{GEN_TOKEN}}
FSP_REGISTRY_WEBHOOK_SECRET={{GEN_TOKEN}}
# true: link an entered fsp_id without Keycloak (local dev only)
FSP_DEV_LINK=false

# --- ATS integration (ats-mock is an internal container, plain http is by design) ---
WEBHOOK_DEV_HOSTS=ats-mock:8082
WEBHOOK_DISPATCH_INTERVAL_MS=2000
ATS_POLL_LAG_SECS=5
ATS_DEMO_API_KEY=fsp_live_{{GEN_TOKEN}}
ATS_DEMO_WEBHOOK_URL=http://ats-mock:8082/webhooks
ATS_DEMO_WEBHOOK_SECRET={{GEN_TOKEN}}

# --- Web (Next.js server-side calls) ---
API_PROXY_URL=http://api:8000

# --- Keycloak admin console (reachable only via ssh tunnel) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD={{GEN_TOKEN}}
