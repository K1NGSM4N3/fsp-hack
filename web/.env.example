# Copy to .env.local and adjust.

# 1 = use in-browser mock data (src/mocks) instead of the API. Inlined at build time.
NEXT_PUBLIC_USE_MOCKS=0

# Backend origin for the /api/* rewrite (local dev and `next start`).
# In docker compose Caddy routes /api/* itself, so this is only a fallback.
API_PROXY_URL=http://localhost:8000

# 0 = hide the demo-account buttons on /login (always shown in mock mode).
NEXT_PUBLIC_DEMO_LOGIN=1
