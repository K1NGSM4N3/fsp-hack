// Linking FSP ID for docs/solution.md §7.1; `make docs` renders every docs/img/*.dot to SVG.
// Colours are the brand tokens of web/src/app/globals.css.
digraph fsp_link {
  graph [rankdir=TB, bgcolor="#ffffff", fontname="PT Sans,DejaVu Sans,sans-serif", fontsize=9,
         fontcolor="#5a5c66", nodesep=0.3, ranksep=0.3, pad=0.1, size="6.8,9", labeljust=l, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="PT Sans,DejaVu Sans,sans-serif", fontsize=10,
         fontcolor="#1b1c21", color="#c8c9ce", fillcolor="#ffffff", penwidth=1, margin="0.12,0.05"];
  edge  [fontname="PT Sans,DejaVu Sans,sans-serif", fontsize=8, fontcolor="#5a5c66",
         color="#7b6fff", arrowsize=0.6, penwidth=1];

  subgraph cluster_platform {
    label="платформа"; style="rounded,filled"; fillcolor="#f5f4ff"; color="#d6d1ff";

    candidate [label=<<b>Кандидат</b><br/><font point-size="8" color="#c8c9ce">«Привязать ФСП ID» в настройках</font>>,
               fillcolor="#1b1c21", fontcolor="#ffffff", color="#1b1c21"];
    start [label=<<b>API</b> · GET /fsp/link/start<br/><font point-size="8" color="#d6d1ff">state, PKCE S256, nonce</font>>,
           fillcolor="#402fff", fontcolor="#ffffff", color="#402fff"];
    callback [shape=plain, style="", label=<
      <table border="0" cellborder="0" cellspacing="0" cellpadding="7" style="rounded" bgcolor="#402fff">
        <tr><td align="left" balign="left"><font color="#ffffff"><b>API</b> · GET /fsp/link/callback</font><br/><font point-size="8" color="#d6d1ff">обмен code на id_token по обратному каналу<br/>проверка подписи (JWKS), iss, aud, nonce<br/>claim fsp_id</font></td></tr>
      </table>>];
    result [shape=plain, style="", label=<
      <table border="1" cellborder="0" cellspacing="0" cellpadding="6" style="rounded" color="#c8c9ce" bgcolor="#ffffff">
        <tr><td align="left" balign="left"><b>Снимок достижений в профиле</b><br/><font point-size="8" color="#5a5c66">из него — ФСП-скор, ранжирование и карточка</font></td></tr>
      </table>>];
  }

  subgraph cluster_fsp {
    label="ФСП"; labeljust=r; style="rounded,filled"; fillcolor="#fdecee"; color="#fbd5da";

    keycloak [label=<<b>Keycloak</b>, realm fsp<br/><font point-size="8" color="#5a5c66">ФСП ID: вход участника</font>>];
    registry [label=<<b>Реестр ФСП</b><br/><font point-size="8" color="#5a5c66">GET /participants/{fsp_id}/achievements<br/>с токеном Bearer</font>>];
  }

  candidate -> start;
  start -> keycloak [label=" 303: state, PKCE, nonce"];
  keycloak -> callback [label=" code"];
  callback -> registry [label=" fsp_id"];
  registry -> result [label=" достижения"];
}
