  "query": "SELECT v.id, v.company_id, v.title, v.description,\n                  (v.status = 'published') AS \"published!\",\n                  e.model AS \"model?\", e.text_hash AS \"text_hash?\"\n           FROM vacancies v\n           LEFT JOIN vacancy_embeddings e ON e.vacancy_id = v.id\n           WHERE v.id = ANY($1)",
