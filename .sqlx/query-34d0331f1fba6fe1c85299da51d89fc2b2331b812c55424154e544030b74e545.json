  "query": "SELECT e.id, e.status AS \"status: NotificationEmailStatus\",\n                  (SELECT count(*) FROM notifications n WHERE n.email_id = e.id) AS \"items!\",\n                  e.created_at, e.sent_at\n           FROM notification_emails e\n           WHERE e.user_id = $1\n           ORDER BY e.created_at DESC",
