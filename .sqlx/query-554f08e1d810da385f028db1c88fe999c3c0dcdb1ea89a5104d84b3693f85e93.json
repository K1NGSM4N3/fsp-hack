{
  "db_name": "PostgreSQL",
  "query": "SELECT i.id, i.company_id, co.name AS company_name, i.title, i.salary_min, i.salary_max,\n                  i.trust_flags, i.created_at\n           FROM invitations i\n           JOIN companies co ON co.id = i.company_id\n           WHERE i.trust_flags <> '[]'\n           ORDER BY i.created_at DESC\n           LIMIT $1",
