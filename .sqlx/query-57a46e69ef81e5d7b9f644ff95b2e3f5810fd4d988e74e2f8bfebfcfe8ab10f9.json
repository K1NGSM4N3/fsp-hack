  "query": "SELECT id, kind, payload::text AS \"payload!\", created_at, read_at\n           FROM notifications\n           WHERE user_id = $1\n             AND (NOT $2 OR read_at IS NULL)\n             AND ($3::uuid IS NULL OR id < $3)\n           ORDER BY id DESC\n           LIMIT $4",
