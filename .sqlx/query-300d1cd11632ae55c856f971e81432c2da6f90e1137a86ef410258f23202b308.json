  "query": "SELECT uc.id, uc.document_id, d.kind, d.version, d.title, uc.granted_at, uc.revoked_at\n         FROM user_consents uc\n         JOIN consent_documents d ON d.id = uc.document_id\n         WHERE uc.user_id = $1\n         ORDER BY uc.granted_at DESC",
